# Copy this file to ".env" to switch the app into API mode.
#
# Leave it EMPTY or delete the file to keep everything in the browser
# (localStorage + IndexedDB) exactly as before.
#
# Point it at your Express server — no trailing slash.
VITE_API_URL=http://localhost:4000

# Once deployed, this becomes your live API, e.g.
# VITE_API_URL=https://projectvault-api.onrender.com

# NOTE: there is deliberately no admin key here.
# You unlock editing by typing the password into the app (padlock icon in the
# top bar). It is then remembered on that device. Keeping it out of the build
# means a visitor who inspects the deployed site finds nothing useful.
