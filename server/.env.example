# Copy this file to ".env" and fill in your own values.
# .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# MongoDB (free: MongoDB Atlas M0 cluster, 512 MB)
# Atlas gives you a string like:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Add the database name (projectvault) before the "?" as shown below.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/projectvault?retryWrites=true&w=majority

# Port this server listens on
PORT=4000

# Which frontend origins may call this API (comma-separated).
# Add your deployed URL here once you have one.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Video + image storage
#
# Leave CLOUDINARY_URL empty to store uploads on this server's disk
# (./uploads). That is fine on your own machine, but free hosts wipe the
# filesystem on restart — set CLOUDINARY_URL before deploying.
#
# Cloudinary free tier: ~25 GB storage. Copy the "API Environment variable"
# value straight from your Cloudinary dashboard:
#   cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# ---------------------------------------------------------------------------
CLOUDINARY_URL=

# Public base URL of this server. Used to build file URLs in disk mode.
PUBLIC_URL="https://projectvault-1-m27u.onrender.com/api"

# Largest upload accepted, in megabytes
MAX_UPLOAD_MB=200

# ---------------------------------------------------------------------------
# Write protection
#
# Anyone may READ your projects. Adding, editing, deleting and uploading
# require this key, sent by your browser in the x-admin-key header.
#
# Leave it empty for local development and writes stay open.
# You MUST set it before deploying, or strangers can delete your projects.
#
# Generate a long random value, e.g. in PowerShell:
#   [guid]::NewGuid().ToString() + [guid]::NewGuid().ToString()
#
# The frontend needs the SAME value as VITE_ADMIN_KEY in its own .env
# ---------------------------------------------------------------------------
ADMIN_KEY=
